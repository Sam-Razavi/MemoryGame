@using System.Linq
@using System.Collections.Generic
@using System.Globalization
@using MemoryGame.Models
@model List<MemoryGame.Models.Tile>

@{
    ViewData["Title"] = "Play";

    int gameId = (int)ViewBag.GameId;
    int? sel1 = ViewBag.Sel1 as int?;

    bool gameCompleted = ViewBag.GameCompleted is bool gcFlag && gcFlag;
    bool isMyTurn = ViewBag.IsMyTurn is bool myTurnFlag && myTurnFlag;

    int totalTiles = ViewBag.TotalTiles is int tt ? tt : Model.Count;
    int matchedTiles = ViewBag.MatchedTiles is int mt ? mt : Model.Count(t => t.IsMatched);
    int remainingPairs = ViewBag.RemainingPairs is int rp ? rp : (totalTiles - matchedTiles) / 2;
    int totalPairs = totalTiles / 2;
    int foundPairs = matchedTiles / 2;
    int progressPct = totalTiles == 0 ? 0 : matchedTiles * 100 / totalTiles;

    int lastTurn = ViewBag.LastTurn is int lt ? lt : 0;
    string statusText = (ViewBag.Status as string) ?? "Waiting";
    string statusLabel = statusText == "InProgress" ? "In progress" : statusText;

    var players = ViewBag.Players as List<PlayerVm> ?? new List<PlayerVm>();
    var scores = ViewBag.Scores as IDictionary<int, int> ?? new Dictionary<int, int>();
    var history = ViewBag.History as List<MoveVm> ?? new List<MoveVm>();
    int? me = ViewBag.MeUserId as int?;
    int? currentTurnUserId = ViewBag.CurrentTurnUserId as int?;
    string? winnerName = ViewBag.WinnerName as string;

    var currentPlayer = currentTurnUserId.HasValue ? players.FirstOrDefault(p => p.UserID == currentTurnUserId.Value) : null;
    bool iWon = gameCompleted && me.HasValue && players.Any(p => p.UserID == me.Value && p.Username == winnerName);

    var lastA = -1; var lastB = -1; var lastMatch = false;
    if (TempData["LastPair"] is string lp)
    {
        var parts = lp.Split(',');
        if (parts.Length == 3)
        {
            int.TryParse(parts[0], out lastA);
            int.TryParse(parts[1], out lastB);
            lastMatch = parts[2] == "1";
        }
    }

    bool canFlip = !gameCompleted && isMyTurn;
}

<div class="play-top">
    <div class="play-title">
        <a asp-action="Lobby" class="btn btn-icon" title="Back to lobby" aria-label="Back to lobby">@Icons.Get("arrow-left", 16)</a>
        <h1>Game <span class="text-dim">#</span>@gameId</h1>
        <span class="pill pill-@statusText.ToLowerInvariant()">@statusLabel</span>
    </div>
    @if (!gameCompleted)
    {
        <span class="live">Live sync</span>
    }
</div>

<partial name="_Alerts" />

<div class="play-layout">
    <div>
        @if (gameCompleted)
        {
            <div class="panel victory">
                <div class="confetti" aria-hidden="true">
                    @for (int i = 0; i < 36; i++)
                    {
                        var style = string.Format(CultureInfo.InvariantCulture,
                            "--x:{0}%;--c:{1};--t:{2:0.00}s;--d:{3:0.00}s",
                            (i * 37) % 100, (i * 47) % 360, 2.4 + (i % 5) * 0.35, (i * 0.13) % 2.5);
                        <i style="@style"></i>
                    }
                </div>
                <div class="victory-main">
                    <div class="victory-icon">@Icons.Get("trophy", 26)</div>
                    <div>
                        @if (winnerName == null || winnerName == "Tie")
                        {
                            <h2>It's a tie!</h2>
                            <p>Evenly matched — all @totalPairs pairs found.</p>
                        }
                        else
                        {
                            <h2>@(iWon ? "You win!" : $"{winnerName} wins!")</h2>
                            <p>All @totalPairs pairs found. Great game.</p>
                        }
                    </div>
                </div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary">@Icons.Get("plus", 16) Start new game</button>
                </form>
            </div>
        }
        else if (isMyTurn)
        {
            <div class="banner banner-turn" role="status">
                <div class="banner-icon">@Icons.Get("sparkles", 18)</div>
                <div>
                    <strong>Your turn</strong>
                    <span>
                        @if (sel1.HasValue)
                        {
                            @:Pick one more card to complete the pair.
                        }
                        else if (players.Count < 2)
                        {
                            @:Waiting for an opponent to join — you can start flipping meanwhile.
                        }
                        else
                        {
                            @:Flip two cards. Find a pair and you go again.
                        }
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="banner banner-wait" role="status">
                <div class="banner-icon">@Icons.Get("clock", 18)</div>
                <div>
                    @if (currentPlayer != null)
                    {
                        <strong>Waiting for @currentPlayer.Username</strong>
                    }
                    else
                    {
                        <strong>Waiting for players…</strong>
                    }
                    <span>The board updates automatically when it's your turn.</span>
                </div>
            </div>
        }

        <div class="progress-row">
            <span>Pairs found</span>
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@totalPairs" aria-valuenow="@foundPairs">
                <span style="width:@progressPct%"></span>
            </div>
            <span class="mono"><strong>@foundPairs</strong> / @totalPairs</span>
        </div>

        <div class="panel board-wrap">
            <div class="board @(canFlip ? "is-playable" : "is-locked")"
                 data-game-id="@gameId"
                 data-me="@me"
                 data-turn="@currentTurnUserId"
                 data-last="@lastTurn"
                 data-status="@ViewBag.Status"
                 data-players="@players.Count">
                @foreach (var t in Model)
                {
                    bool isSelected = sel1.HasValue && sel1.Value == t.TileID;
                    bool isLastPicked = (t.TileID == lastA || t.TileID == lastB);
                    bool showFace = t.IsMatched || isSelected || isLastPicked;

                    var classes = "tile";
                    if (t.IsMatched) classes += " tile-matched";
                    else if (isSelected) classes += " tile-selected";
                    if (isLastPicked) classes += lastMatch ? " last-match" : " last-miss";
                    if (isSelected || isLastPicked) classes += " just-revealed";
                    if (showFace) classes += " flipped";

                    <div class="@classes" style="--h:@CardArt.Hue(t.CardName)">
                        <div class="tile-inner">
                            <div class="tile-side tile-back">
                                <partial name="_BrandMark" />
                                @if (!showFace)
                                {
                                    if (canFlip)
                                    {
                                        <form asp-action="Flip" method="post" class="tile-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@gameId" />
                                            <input type="hidden" name="tileId" value="@t.TileID" />
                                            <button type="submit" class="tile-btn" aria-label="Flip card @(t.Position + 1)"></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="tile-btn" disabled aria-label="Card @(t.Position + 1)"></button>
                                    }
                                }
                            </div>
                            <partial name="_CardFace" model="t.CardName" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <aside class="play-side">
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">@Icons.Get("users", 16) Players</div>
                <span class="panel-meta">@remainingPairs pairs left</span>
            </div>
            <div class="scoreboard">
                @foreach (var p in players)
                {
                    var score = scores.ContainsKey(p.UserID) ? scores[p.UserID] : 0;
                    bool turn = currentTurnUserId.HasValue && currentTurnUserId.Value == p.UserID && !gameCompleted;
                    bool winner = gameCompleted && p.Username == winnerName;
                    bool isMe = me.HasValue && me.Value == p.UserID;

                    <div class="player @(turn ? "is-turn" : "") @(winner ? "is-winner" : "")">
                        <span class="avatar avatar-lg" style="--h:@CardArt.Hue(p.Username)">@CardArt.Monogram(p.Username)</span>
                        <div class="player-info">
                            <div class="player-name">@p.Username@(isMe ? " (you)" : "")</div>
                            <div class="player-meta">
                                @if (winner)
                                {
                                    @:Winner
                                }
                                else if (turn)
                                {
                                    <span class="turn-dot"></span>@:Playing now
                                }
                                else
                                {
                                    @:Player @p.PlayerOrder
                                }
                            </div>
                        </div>
                        <div class="player-score" title="Pairs found">@score</div>
                    </div>
                }
                @for (int i = players.Count; i < 2; i++)
                {
                    <div class="player is-empty">
                        <span class="avatar avatar-lg avatar-empty">?</span>
                        <div class="player-info">
                            <div class="player-name">Open seat</div>
                            <div class="player-meta">Waiting for opponent…</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">@Icons.Get("history", 16) Moves</div>
                <span class="panel-meta">@history.Count total</span>
            </div>
            @if (history.Any())
            {
                <ol class="timeline">
                    @foreach (var m in Enumerable.Reverse(history))
                    {
                        <li>
                            <span class="timeline-mark @(m.IsMatch ? "hit" : "miss")">@Icons.Get(m.IsMatch ? "check" : "x", 14)</span>
                            <div class="timeline-body">
                                <strong>@m.Username</strong> @(m.IsMatch ? "found a pair" : "missed")
                                <div class="timeline-time" title="@m.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)">
                                    @m.CreatedAt.ToString("HH:mm:ss", CultureInfo.InvariantCulture)
                                </div>
                            </div>
                            <span class="timeline-turn">#@m.TurnNumber</span>
                        </li>
                    }
                </ol>
            }
            else
            {
                <div class="timeline-empty">No moves yet — the first flip is yours to make.</div>
            }
        </div>
    </aside>
</div>

<div id="joinToast" class="toast" role="status">@Icons.Get("check", 18) An opponent joined. Loading…</div>

@section Scripts {
    <script>
        (function(){
            const grid = document.querySelector('.board');
            if (!grid) return;

            const gameId = grid.dataset.gameId;
            const me = parseInt(grid.dataset.me || '-1', 10);
            let lastTurn = parseInt(grid.dataset.last || '0', 10);
            let lastStatus = (grid.dataset.status || '').toString();
            let lastPlayerCount = parseInt(grid.dataset.players || '0', 10);
            const pollMs = 2000;

            function showToast() {
                const t = document.getElementById('joinToast');
                if (t) t.style.display = 'flex';
            }

            async function poll() {
                try {
                    const res = await fetch('@Url.Action("State", "Game")' + '?id=' + encodeURIComponent(gameId), {
                        method: 'GET',
                        cache: 'no-store'
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data.ok) return;

                    const statusChanged = data.status !== lastStatus;
                    const newMove = (data.lastTurn || 0) > lastTurn;
                    // Only reload when the turn passes to us (not on every tick while it's already ours)
                    const itsMyTurn = (data.currentTurnUserId === me) && !isMyTurn;

                    // Detect someone joined: playerCount 1 -> 2 while Waiting
                    const playersNow = parseInt(data.playerCount || 0, 10);
                    const someoneJoined = (lastStatus === 'Waiting' && lastPlayerCount === 1 && playersNow === 2);
                    if (someoneJoined) {
                        showToast();
                        setTimeout(() => window.location.reload(), 800);
                        return;
                    }

                    if (statusChanged || newMove || itsMyTurn) {
                        window.location.reload();
                        return;
                    }
                } catch (e) { /* ignore */ }
            }

            const isMyTurn = '@(isMyTurn ? "true" : "false")' === 'true';
            const gameCompleted = '@(gameCompleted ? "true" : "false")' === 'true';

            // Always poll while Waiting; otherwise only when it's not your turn & not completed
            if (lastStatus === 'Waiting') {
                setInterval(poll, pollMs);
            } else if (!isMyTurn && !gameCompleted) {
                setInterval(poll, pollMs);
            }
        })();
    </script>
}
