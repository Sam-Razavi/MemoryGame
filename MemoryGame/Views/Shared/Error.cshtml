@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth">
    <h1>Something went wrong</h1>
    <p class="muted">The server couldn't finish that request. Try again, or go back to the <a asp-controller="Home" asp-action="Index">start page</a>.</p>

    @if (Model.ShowRequestId)
    {
        <p class="hint">Request ID: <span class="code">@Model.RequestId</span></p>
    }
</div>
