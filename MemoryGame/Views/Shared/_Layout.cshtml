@using Microsoft.AspNetCore.Http
@{
    var userId = Context.Session.GetInt32("UserID");
    var username = Context.Session.GetString("Username");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07080f" />
    <title>@ViewData["Title"] · MemoryGame</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="backdrop" aria-hidden="true"></div>

    @* Shared gradient referenced by every brand mark on the page *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="mg-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#8b6dff" />
                <stop offset=".55" stop-color="#5b7cff" />
                <stop offset="1" stop-color="#22d3ee" />
            </linearGradient>
        </defs>
    </svg>

    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <partial name="_BrandMark" />
                MemoryGame
            </a>

            <button class="nav-toggle" type="button" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                @Icons.Get("menu", 20)
            </button>

            <nav class="nav" id="mainNav">
                <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link @Active("Game")" asp-controller="Game" asp-action="Lobby">Lobby</a>
                <a class="nav-link @Active("CardAdmin")" asp-controller="CardAdmin" asp-action="Index">Cards</a>

                <div class="nav-user">
                    @if (userId is not null)
                    {
                        <span class="user-chip">
                            <span class="avatar" style="--h:@CardArt.Hue(username)">@CardArt.Monogram(username)</span>
                            @username
                        </span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm" title="Log out">
                                @Icons.Get("log-out", 16) <span>Log out</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main role="main" class="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>&copy; @DateTime.Now.Year MemoryGame · Databasteknik och Webbaserade System</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
