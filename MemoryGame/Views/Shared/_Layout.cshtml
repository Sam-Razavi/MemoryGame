@using Microsoft.AspNetCore.Http
@{
    var userId = Context.Session.GetInt32("UserID");
    var username = Context.Session.GetString("Username");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Memory</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Public+Sans:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-cards" aria-hidden="true"></span>
                Memory
            </a>

            <button class="nav-toggle" type="button" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>

            <nav class="nav" id="mainNav">
                <a class="nav-link @Active("Game")" asp-controller="Game" asp-action="Lobby">Lobby</a>
                <a class="nav-link @Active("CardAdmin")" asp-controller="CardAdmin" asp-action="Index">Deck</a>

                <div class="nav-user">
                    @if (userId is not null)
                    {
                        <span class="muted">Signed in as <strong>@username</strong></span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="link-btn">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main role="main" class="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>Memory &middot; a school project for Databasteknik och webbaserade system, IT-Högskolan</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
