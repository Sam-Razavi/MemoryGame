@{
    ViewData["Title"] = "Log in";
    var username = Context.Request.HasFormContentType ? Context.Request.Form["username"].ToString() : "";
}

<div class="auth">
    <div class="panel auth-card">
        <div class="auth-head">
            <partial name="_BrandMark" />
            <h1>Welcome back</h1>
            <p>Log in to jump back into the lobby.</p>
        </div>

        <partial name="_AuthErrors" />

        <form method="post">
            <div class="field">
                <label class="label" for="username">Username</label>
                <input class="input" id="username" name="username" value="@username"
                       autocomplete="username" placeholder="Your username" required autofocus />
            </div>
            <div class="field">
                <label class="label" for="password">Password</label>
                <input class="input" id="password" name="password" type="password"
                       autocomplete="current-password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block">
                @Icons.Get("log-in", 18) Log in
            </button>
        </form>

        <div class="auth-foot">
            New here? <a asp-action="Register">Create an account</a>
        </div>
    </div>
</div>
