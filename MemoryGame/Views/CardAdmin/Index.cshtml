@model IEnumerable<MemoryGame.Models.Card>
@{
    ViewData["Title"] = "Deck";
    var cards = Model?.ToList() ?? new List<MemoryGame.Models.Card>();
}

<div class="page-head">
    <div>
        <h1>Deck</h1>
        <p class="muted">@cards.Count cards. New games pick their cards from this list.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add card</a>
</div>

<partial name="_Alerts" />

@if (!cards.Any())
{
    <div class="panel empty">
        The deck is empty. A default set of cards is added the first time someone starts a game,
        or you can add your own.
    </div>
}
else
{
    <div class="panel table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th>Card</th>
                    <th>Pair key</th>
                    <th class="hide-sm">ID</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in cards)
                {
                    <tr>
                        <td><span class="mini-card">@(CardArt.Emoji(c.Name) ?? CardArt.Monogram(c.Name))</span>@c.Name</td>
                        <td class="code">@c.PairKey</td>
                        <td class="num faint hide-sm">@c.CardID</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@c.CardID" class="link-btn">Edit</a>
                                <form asp-action="Delete" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.CardID" />
                                    <button class="link-btn danger" type="submit"
                                            onclick="return confirm('Delete card #@c.CardID (@c.Name)?');">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
