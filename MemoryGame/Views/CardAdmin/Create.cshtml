@model MemoryGame.Models.Card
@{
    ViewData["Title"] = "New card";
}

<a asp-action="Index" class="back">&larr; Deck</a>
<div class="page-head">
    <div>
        <h1>New card</h1>
        <p class="muted">Every card needs a partner, so add a second one with the same pair key.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_CardForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
