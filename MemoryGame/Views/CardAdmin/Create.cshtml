@model MemoryGame.Models.Card
@{
    ViewData["Title"] = "New card";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="eyebrow">@Icons.Get("arrow-left", 14) Card library</a>
        <h1 class="page-title">New card</h1>
        <p class="page-subtitle">Add a card to the deck. Remember to create its partner with the same pair key.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_CardForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
