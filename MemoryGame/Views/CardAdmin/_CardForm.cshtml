@model MemoryGame.Models.Card
@{
    var name = string.IsNullOrWhiteSpace(Model?.Name) ? "?" : Model!.Name;
}

<div class="form-layout">
    <div>
        <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

        <div class="field">
            <label asp-for="Name" class="label">Name</label>
            <input asp-for="Name" class="input" autofocus />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="PairKey" class="label">Pair key</label>
            <input asp-for="PairKey" class="input" />
            <div class="hint">Two cards with the same pair key count as a match.</div>
            <span asp-validation-for="PairKey" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="muted">Cancel</a>
        </div>
    </div>

    <div class="preview">
        <div class="felt">
            <div class="tile">
                <div class="tile-inner">
                    <div class="tile-side tile-back"></div>
                    <partial name="_CardFace" model="name" />
                </div>
            </div>
        </div>
        <p class="hint">Common names (Apple, Cat, Rocket...) get a picture. Anything else shows its first letter.</p>
    </div>
</div>
