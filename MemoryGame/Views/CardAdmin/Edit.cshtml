@model MemoryGame.Models.Card
@{
    ViewData["Title"] = "Edit card";
}

<a asp-action="Index" class="back">&larr; Deck</a>
<div class="page-head">
    <div>
        <h1>Edit card #@Model.CardID</h1>
        <p class="muted">Changes only affect games created after you save.</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CardID" />
    <partial name="_CardForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
