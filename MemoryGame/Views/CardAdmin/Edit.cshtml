@model MemoryGame.Models.Card
@{
    ViewData["Title"] = "Edit card";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="eyebrow">@Icons.Get("arrow-left", 14) Card library</a>
        <h1 class="page-title">Edit card <span class="text-dim">#@Model.CardID</span></h1>
        <p class="page-subtitle">Changes apply to new games. Games in progress keep their cards.</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CardID" />
    <partial name="_CardForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
