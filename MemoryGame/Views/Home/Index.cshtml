@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home";
    bool signedIn = Context.Session.GetInt32("UserID") is not null;

    // A board mid-game: some pairs taken, a couple of cards that peek now and then
    var board = new (string Name, string State, double Delay)[]
    {
        ("Cat", "matched", 0), ("", "down", 0),   ("", "down", 0),    ("Apple", "cycle", 1.0),
        ("", "down", 0),      ("Dog", "up", 0),   ("", "down", 0),    ("", "down", 0),
        ("", "down", 0),      ("", "down", 0),    ("Cat", "matched", 0), ("", "down", 0),
        ("Star", "cycle", 4.2), ("", "down", 0),  ("", "down", 0),    ("Fox", "up", 0),
    };
}

<section class="home">
    <div>
        <h1>Memory</h1>
        <p class="lead">
            The card game you probably played as a kid, for two players online.
            Sixteen cards, eight pairs. Turn over two at a time and try to remember where everything is.
        </p>
        <div class="home-actions">
            <a asp-controller="Game" asp-action="Lobby" class="btn btn-primary">Go to the lobby</a>
            @if (!signedIn)
            {
                <a asp-controller="Account" asp-action="Register" class="btn">Create an account</a>
            }
        </div>

        <ol class="home-rules">
            <li><span>1</span>One player creates a game in the lobby, the other joins it.</li>
            <li><span>2</span>On your turn, flip two cards. If they match you keep the pair and go again.</li>
            <li><span>3</span>If they don't match, it's the other player's turn. Most pairs wins.</li>
        </ol>
    </div>

    <div class="felt" aria-hidden="true">
        <div class="board">
            @foreach (var c in board)
            {
                var cls = c.State switch
                {
                    "matched" => "tile flipped tile-matched",
                    "up" => "tile flipped",
                    "cycle" => "tile cycle",
                    _ => "tile"
                };
                <div class="@cls" style="--d:@(c.Delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                    <div class="tile-inner">
                        <div class="tile-side tile-back"></div>
                        @if (c.Name.Length > 0)
                        {
                            <partial name="_CardFace" model="c.Name" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
